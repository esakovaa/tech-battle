# --- Orchestration layer (src/app/api/agent) ---------------------------
# Which provider the agent talks to. "anthropic" or "openai".
LLM_PROVIDER=anthropic

# Only the one matching LLM_PROVIDER needs to actually be set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model id for whichever provider you picked. Required — there's no
# hardcoded default, since model ids go stale and a wrong guess baked into
# the code is worse than an explicit startup error telling you to set one.
# Check your provider's current model list before filling this in; these
# are illustrative examples of the *shape*, not a recommendation:
#   ANTHROPIC_MODEL=claude-sonnet-4-5
#   OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Web search tool (used for objection-handling in step 7, e.g. "is there a
# Kita nearby without needing a car"). Get a free-tier key at tavily.com.
# If unset, the web_search tool responds with a clear "not configured"
# message instead of crashing the agent loop.
TAVILY_API_KEY=

# Mock mode: set to 1 to demo the write-up + chat without any API key.
# /api/agent then streams pre-written replies filled in from the real
# ranking data (see src/lib/agent-mock.ts). Takes precedence over the
# LLM settings above — remove it (or set 0) to use the real model.
AGENT_MOCK=

# --- Existing (geocoding, no key needed — Nominatim usage policy applies) -
# No env var: src/lib/geocode.ts calls nominatim.openstreetmap.org directly.

# --- KiezMap tile skin (optional) ---------------------------------------
# Thunderforest's "Pioneer" style — closer to the Wurzelraum cottagecore
# look than plain OpenStreetMap tiles. Free tier, signup at
# thunderforest.com. NEXT_PUBLIC_ because it's read client-side (the
# browser fetches tiles directly) — the key is visible in the network tab
# by design, same as any Thunderforest usage; Thunderforest's own rate
# limiting is what guards it, not secrecy. If unset, KiezMap falls back to
# standard keyless OpenStreetMap tiles.
NEXT_PUBLIC_THUNDERFOREST_API_KEY=
