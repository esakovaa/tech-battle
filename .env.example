# --- Orchestration layer (src/app/api/agent) ---------------------------
# Which provider the agent talks to. "anthropic" or "openai".
LLM_PROVIDER=anthropic

# Only the one matching LLM_PROVIDER needs to actually be set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model id for whichever provider you picked. Required — there's no
# hardcoded default, since model ids go stale and a wrong guess baked into
# the code is worse than an explicit startup error telling you to set one.
# Check your provider's current model list before filling this in; these
# are illustrative examples of the *shape*, not a recommendation:
#   ANTHROPIC_MODEL=claude-sonnet-4-5
#   OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Web search tool (used for objection-handling in step 7, e.g. "is there a
# Kita nearby without needing a car"). Get a free-tier key at tavily.com.
# If unset, the web_search tool responds with a clear "not configured"
# message instead of crashing the agent loop.
TAVILY_API_KEY=

# --- Existing (geocoding, no key needed — Nominatim usage policy applies) -
# No env var: src/lib/geocode.ts calls nominatim.openstreetmap.org directly.
